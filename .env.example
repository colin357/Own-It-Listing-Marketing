# Password for /admin (HTTP basic auth). Username can be anything unless ADMIN_USER is set.
ADMIN_PASSWORD=change-me
# ADMIN_USER=admin

# Secret for the automation API (Zapier / Make / CRM): send "Authorization: Bearer <API_KEY>".
API_KEY=generate-a-long-random-string

# Optional: canonical public URL used in share links (e.g. https://kits.ownitsocial.com).
# Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=

# --- Injected automatically by Vercel Marketplace integrations ---
# Upstash Redis (database for listings + loan officers)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel Blob (photo uploads from the admin form)
# BLOB_READ_WRITE_TOKEN=

# --- New-listing detection (optional) ---
# Daily job (vercel.json cron) that finds new listings by agents in your roster.
# Listings feed: https://www.rentcast.io/api
# RENTCAST_API_KEY=
# Photos + description scraped from the public Zillow listing via Apify (https://apify.com):
# APIFY_TOKEN=
# APIFY_ZILLOW_ACTOR=maxcopell~zillow-detail-scraper
# Or any endpoint that returns {"photos": [...]} for a posted listing:
# PHOTO_LOOKUP_URL=
# PHOTO_LOOKUP_TOKEN=
# Vercel sets this for its cron requests; any long random string.
# CRON_SECRET=
# Optional: POSTed {"event":"kit.created", kitUrl, agent, loanOfficer, …} for each new kit (Zapier/Make).
# DETECTION_WEBHOOK_URL=
# Local testing without a feed: serve data/mock-listings.json
# LISTINGS_PROVIDER=mock
