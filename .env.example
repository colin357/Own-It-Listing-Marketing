# Password for /admin (HTTP basic auth). Username can be anything unless ADMIN_USER is set.
ADMIN_PASSWORD=change-me
# ADMIN_USER=admin

# Secret for the automation API (Zapier / Make / CRM): send "Authorization: Bearer <API_KEY>".
API_KEY=generate-a-long-random-string

# Optional: canonical public URL used in share links (e.g. https://kits.ownitsocial.com).
# Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=

# --- Injected automatically by Vercel Marketplace integrations ---
# Upstash Redis (database for listings + loan officers)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel Blob (photo uploads from the admin form)
# BLOB_READ_WRITE_TOKEN=
